{
  "id": "telegram-agent",
  "name": "Telegram - Agente de atendimento",
  "active": false,
  "nodes": [
    {
      "id": "n-webhook",
      "name": "Receber update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "telegram-agent-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "n-filter",
      "name": "Filtrar update",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c-secret",
              "leftValue": "={{ $json.headers['x-telegram-bot-api-secret-token'] }}",
              "rightValue": "={{ $env.TELEGRAM_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c-text",
              "leftValue": "={{ (($json.body.message || {}).text || '') }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n-conversation",
      "name": "Criar ou achar conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -80],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/conversations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegramChatId: $('Receber update').item.json.body.message.chat.id, studentName: $('Receber update').item.json.body.message.from.first_name || 'Aluno' }) }}",
        "options": { "timeout": 15000 }
      }
    },
    {
      "id": "n-agent",
      "name": "Enviar mensagem ao agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -80],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/conversations/{{ $json.id }}/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Receber update').item.json.body.message.text }) }}",
        "options": { "timeout": 45000 }
      }
    },
    {
      "id": "n-reply",
      "name": "Responder no Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -160],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Receber update').item.json.body.message.chat.id, text: $json.content }) }}",
        "options": { "timeout": 15000 }
      }
    },
    {
      "id": "n-fallback",
      "name": "Avisar indisponibilidade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 40],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Receber update').item.json.body.message.chat.id, text: 'Tive um problema agora. Pode tentar de novo em instantes?' }) }}",
        "options": { "timeout": 15000 }
      }
    }
  ],
  "connections": {
    "Receber update": {
      "main": [[{ "node": "Filtrar update", "type": "main", "index": 0 }]]
    },
    "Filtrar update": {
      "main": [[{ "node": "Criar ou achar conversa", "type": "main", "index": 0 }], []]
    },
    "Criar ou achar conversa": {
      "main": [
        [{ "node": "Enviar mensagem ao agente", "type": "main", "index": 0 }],
        [{ "node": "Avisar indisponibilidade", "type": "main", "index": 0 }]
      ]
    },
    "Enviar mensagem ao agente": {
      "main": [
        [{ "node": "Responder no Telegram", "type": "main", "index": 0 }],
        [{ "node": "Avisar indisponibilidade", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
